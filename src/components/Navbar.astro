---
import { WA_DEFAULT } from '../config/contact';
// `featured` flag highlights a seasonal/feature link. Remove the Karkidaka entry
// (and its featured flag) after Karkidakam 2026 ends, see comment on 16 Aug 2026.
const navLinks: { label: string; href: string; featured?: boolean }[] = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Treatments', href: '/treatments/' },
  { label: 'Packages', href: '/packages/' },
  { label: 'Karkidaka 2026', href: '/karkidaka-chikitsa/', featured: true },
  { label: 'Conditions', href: '/conditions/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;
const whatsappUrl = WA_DEFAULT;
---

<!-- Announcement Bar, Karkidaka season hook. Whole bar is one tap target.
     Rotate or revert after 16 Aug 2026. -->
<header id="site-header" class="sticky top-0 z-40">
<a
  id="announcement-bar"
  href="/packages/karkidaka-chikitsa/"
  class="announcement-bar-bg block hover:opacity-95 transition-opacity"
  style="color: var(--color-bg-deep);"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 py-3 min-h-[44px] flex items-center justify-center">
    <p class="text-center font-body text-sm font-light">
      The body's annual reset, Karkidakam 2026 now booking.
      <span class="underline underline-offset-2 font-medium ml-1">View package →</span>
    </p>
  </div>
</a>

<style>
  .announcement-bar-bg {
    background: linear-gradient(90deg, var(--color-gold-dark) 0%, var(--color-gold) 40%, var(--color-gold-light) 60%, var(--color-gold) 80%, var(--color-gold-dark) 100%);
  }
  /* Subtle pulse on the seasonal nav indicator, "live this season". */
  .nav-live-dot {
    animation: nav-live-pulse 2.4s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
  @keyframes nav-live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(0.85); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav-live-dot { animation: none; }
  }
</style>

<!-- Main Navbar -->
<nav id="main-nav" class="bg-brand-bg border-b border-brand-gold-border">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">

    <!-- Logo -->
    <a href="/" class="flex min-w-0 flex-col leading-tight">
      <span class="font-display text-[clamp(1rem,5vw,1.25rem)] md:text-2xl text-brand-gold tracking-wide whitespace-nowrap">VAIDYA VRINDAVANAM</span>
      <span class="text-[clamp(0.5625rem,2.6vw,0.75rem)] text-text-muted tracking-widest uppercase whitespace-nowrap">Ayurveda Hospital · Haripad</span>
    </a>

    <!-- Desktop Nav Links -->
    <ul class="hidden xl:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        const baseClasses = "px-3 py-2 text-sm font-body transition-colors rounded-sm inline-flex items-center gap-1.5";
        const stateClasses = isActive
          ? 'text-brand-gold border-b border-brand-gold'
          : link.featured
            ? 'text-brand-gold hover:text-text-primary'
            : 'text-text-secondary hover:text-text-primary';
        return (
          <li>
            <a href={link.href} class={`${baseClasses} ${stateClasses}`}>
              {link.featured && (
                <span aria-hidden="true" class="nav-live-dot w-1.5 h-1.5 rounded-full bg-brand-gold inline-block"></span>
              )}
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Book Now Button (Desktop) -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="hidden xl:inline-flex shrink-0 items-center gap-2 min-h-[44px] bg-brand-gold text-brand-bg text-xs font-body font-semibold tracking-widest uppercase px-5 py-2.5 rounded-sm hover:bg-brand-gold/90 transition-colors"
    >
      BOOK NOW
    </a>

    <!-- Hamburger (Mobile) -->
    <button
      id="menu-open"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="xl:hidden flex shrink-0 min-w-[44px] min-h-[44px] items-center justify-center flex-col gap-1.5 p-2"
    >
      <span class="w-6 h-0.5 bg-brand-gold block"></span>
      <span class="w-6 h-0.5 bg-brand-gold block"></span>
      <span class="w-6 h-0.5 bg-brand-gold block"></span>
    </button>
  </div>
</nav>
</header>

<!-- Mobile Full-Screen Overlay -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  class="fixed inset-0 z-[100] bg-brand-bg flex flex-col items-center overflow-y-auto overscroll-contain px-4 pt-20 pb-8 hidden"
>
  <!-- Close Button -->
  <button
    id="menu-close"
    aria-label="Close menu"
    class="fixed top-4 right-4 min-w-[44px] min-h-[44px] bg-brand-bg text-brand-gold text-4xl leading-none"
  >
    &times;
  </button>

  <div class="my-auto flex shrink-0 w-full flex-col items-center gap-4">
  <!-- Logo inside overlay -->
  <div class="text-center mb-4">
    <div class="font-display text-2xl text-brand-gold tracking-wide">VAIDYA VRINDAVANAM</div>
    <div class="text-xs text-text-muted tracking-widest uppercase mt-1">Ayurveda Hospital · Haripad</div>
  </div>

  <!-- Mobile Nav Links -->
  <ul class="flex flex-col items-center gap-2">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      const stateClasses = isActive
        ? 'text-brand-gold'
        : link.featured
          ? 'text-brand-gold hover:text-text-primary'
          : 'text-text-primary hover:text-brand-gold';
      return (
        <li>
          <a href={link.href} class={`font-body text-2xl transition-colors inline-flex items-center min-h-[44px] gap-2 ${stateClasses}`}>
            {link.featured && (
              <span aria-hidden="true" class="nav-live-dot w-2 h-2 rounded-full bg-brand-gold inline-block"></span>
            )}
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>

  <!-- Book Now (Mobile) -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 bg-brand-gold text-brand-bg text-sm font-body font-semibold tracking-widest uppercase px-8 py-3 rounded-sm hover:bg-brand-gold/90 transition-colors"
  >
    BOOK NOW
  </a>
  </div>
</div>

<script>
  // The announcement can wrap and fonts can change the header's height.
  // Share measured offsets with sticky navigation and anchor destinations.
  const header = document.getElementById('site-header');
  const sectionNav = document.querySelector<HTMLElement>('nav[aria-label="On this page"]');
  const updateOffsets = () => {
    document.documentElement.style.setProperty('--site-header-height', `${header?.getBoundingClientRect().height ?? 0}px`);
    document.documentElement.style.setProperty('--section-nav-height', `${sectionNav?.getBoundingClientRect().height ?? 0}px`);
  };
  const offsetObserver = new ResizeObserver(updateOffsets);
  if (header) offsetObserver.observe(header);
  if (sectionNav) offsetObserver.observe(sectionNav);
  updateOffsets();

  const openBtn = document.getElementById('menu-open') as HTMLElement | null;
  const closeBtn = document.getElementById('menu-close') as HTMLElement | null;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;

  const getFocusable = () =>
    Array.from(
      mobileMenu?.querySelectorAll<HTMLElement>(
        'a, button, input, [tabindex]:not([tabindex="-1"])'
      ) ?? []
    ).filter(el => !el.hasAttribute('disabled'));

  const openMenu = () => {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    openBtn?.setAttribute('aria-expanded', 'true');
    // Move focus into the menu
    const focusable = getFocusable();
    focusable[0]?.focus();
  };

  const closeMenu = () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
    openBtn?.setAttribute('aria-expanded', 'false');
    if (openBtn?.offsetParent !== null) openBtn?.focus();
  };

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  window.matchMedia('(min-width: 1280px)').addEventListener('change', (event) => {
    if (event.matches && !mobileMenu?.classList.contains('hidden')) closeMenu();
  });

  // Close on link click or Escape
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  mobileMenu?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') { closeMenu(); return; }
    if (e.key !== 'Tab') return;
    const focusable = getFocusable();
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last?.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first?.focus(); }
    }
  });
</script>
