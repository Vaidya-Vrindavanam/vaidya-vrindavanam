---
import { WA_DEFAULT } from '../config/contact';
const navLinks: { label: string; href: string }[] = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Treatments', href: '/treatments/' },
  { label: 'Packages', href: '/packages/' },
  { label: 'Conditions', href: '/conditions/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;
const whatsappUrl = WA_DEFAULT;
---

<!-- Evergreen consultation prompt. Whole bar is one tap target. -->
<a
  id="announcement-bar"
  href="/packages/"
  aria-label="Explore consultations"
  class="announcement-bar-bg sticky top-0 z-50 block hover:opacity-95 transition-opacity"
  style="color: var(--color-bg-deep);"
>
  <div class="max-w-7xl mx-auto px-6 sm:px-8 py-3 min-h-[44px] flex items-center justify-center">
    <p class="text-center font-body text-sm font-light">
      Authentic Kerala Ayurveda
      <span class="underline underline-offset-2 font-medium ml-3">Explore consultations →</span>
    </p>
  </div>
</a>

<style>
  .announcement-bar-bg {
    background: linear-gradient(90deg, var(--color-gold-dark) 0%, var(--color-gold) 40%, var(--color-gold-light) 60%, var(--color-gold) 80%, var(--color-gold-dark) 100%);
  }
</style>

<!-- Main Navbar -->
<nav id="main-nav" class="sticky top-[44px] z-40 bg-brand-bg border-b border-brand-gold-border">
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">

    <!-- Logo -->
    <a href="/" class="flex flex-col leading-tight">
      <span class="font-display text-xl md:text-2xl text-brand-gold tracking-wide">VAIDYA VRINDAVANAM</span>
      <span class="text-xs text-text-muted tracking-widest uppercase">Ayurveda Hospital · Haripad</span>
    </a>

    <!-- Desktop Nav Links -->
    <ul class="hidden lg:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        const baseClasses = "px-3 py-2 text-sm font-body transition-colors rounded-sm inline-flex items-center gap-1.5";
        const stateClasses = isActive
          ? 'text-brand-gold border-b border-brand-gold'
          : 'text-text-secondary hover:text-text-primary';
        return (
          <li>
            <a href={link.href} class={`${baseClasses} ${stateClasses}`}>
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>

    <!-- Book Now Button (Desktop) -->
    <a
      href={whatsappUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-analytics-event="whatsapp_click"
      data-analytics-location="navbar_desktop"
      class="hidden lg:inline-flex items-center gap-2 min-h-[44px] bg-brand-gold text-brand-bg text-xs font-body font-semibold tracking-widest uppercase px-5 py-2.5 rounded-sm hover:bg-brand-gold/90 transition-colors"
    >
      BOOK NOW
    </a>

    <!-- Hamburger (Mobile) -->
    <button
      id="menu-open"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="lg:hidden flex flex-col gap-1.5 p-2"
    >
      <span class="w-6 h-0.5 bg-brand-gold block"></span>
      <span class="w-6 h-0.5 bg-brand-gold block"></span>
      <span class="w-6 h-0.5 bg-brand-gold block"></span>
    </button>
  </div>
</nav>

<!-- Mobile Full-Screen Overlay -->
<div
  id="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  class="fixed inset-0 z-[100] bg-brand-bg flex flex-col items-center justify-center gap-8 hidden"
>
  <!-- Close Button -->
  <button
    id="menu-close"
    aria-label="Close menu"
    class="absolute top-5 right-5 text-brand-gold text-4xl leading-none"
  >
    &times;
  </button>

  <!-- Logo inside overlay -->
  <div class="text-center mb-4">
    <div class="font-display text-2xl text-brand-gold tracking-wide">VAIDYA VRINDAVANAM</div>
    <div class="text-xs text-text-muted tracking-widest uppercase mt-1">Ayurveda Hospital · Haripad</div>
  </div>

  <!-- Mobile Nav Links -->
  <ul class="flex flex-col items-center gap-6">
    {navLinks.map((link) => {
      const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
      const stateClasses = isActive
        ? 'text-brand-gold'
        : 'text-text-primary hover:text-brand-gold';
      return (
        <li>
          <a href={link.href} class={`font-body text-2xl transition-colors inline-flex items-center gap-2 ${stateClasses}`}>
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>

  <!-- Book Now (Mobile) -->
  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    data-analytics-event="whatsapp_click"
    data-analytics-location="navbar_mobile"
    class="mt-4 bg-brand-gold text-brand-bg text-sm font-body font-semibold tracking-widest uppercase px-8 py-3 rounded-sm hover:bg-brand-gold/90 transition-colors"
  >
    BOOK NOW
  </a>
</div>

<script>
  const openBtn = document.getElementById('menu-open') as HTMLElement | null;
  const closeBtn = document.getElementById('menu-close') as HTMLElement | null;
  const mobileMenu = document.getElementById('mobile-menu') as HTMLElement | null;

  const getFocusable = () =>
    Array.from(
      mobileMenu?.querySelectorAll<HTMLElement>(
        'a, button, input, [tabindex]:not([tabindex="-1"])'
      ) ?? []
    ).filter(el => !el.hasAttribute('disabled'));

  const openMenu = () => {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    openBtn?.setAttribute('aria-expanded', 'true');
    // Move focus into the menu
    const focusable = getFocusable();
    focusable[0]?.focus();
  };

  const closeMenu = () => {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
    openBtn?.setAttribute('aria-expanded', 'false');
    openBtn?.focus();
  };

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);

  // Close on link click or Escape
  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  mobileMenu?.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') { closeMenu(); return; }
    if (e.key !== 'Tab') return;
    const focusable = getFocusable();
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last?.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first?.focus(); }
    }
  });
</script>
