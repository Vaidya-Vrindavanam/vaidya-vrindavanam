---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TreatmentCard from '../../components/TreatmentCard.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { getTreatments, getConditions } from '../../lib/sanity';
import type { Treatment, Condition } from '../../lib/sanity';
import {
  PHONE_PRIMARY_RAW,
  ADDRESS_LOCALITY,
  ADDRESS_DISTRICT,
  ADDRESS_REGION,
  ADDRESS_POSTAL_CODE,
  POSTAL_ADDRESS_SCHEMA,
} from '../../config/contact';
import { treatmentSeoDescriptions, treatmentSeoTitles } from '../../data/seoDescriptions';
import { treatmentDetails } from '../../data/treatmentDetails';

export async function getStaticPaths() {
  const [treatments, conditions] = await Promise.all([
    getTreatments(),
    getConditions(),
  ]);
  return treatments.map(treatment => {
    // Up to 3 sibling treatments from the same category, ordered by `order`
    const related = treatments
      .filter(t => t.category === treatment.category && t.slug !== treatment.slug)
      .slice(0, 3);
    return {
      params: { slug: treatment.slug },
      props: { treatment, related, allConditions: conditions },
    };
  });
}

const { treatment, related, allConditions } = Astro.props as { treatment: Treatment; related: Treatment[]; allConditions: Condition[] };
const detail = treatmentDetails[treatment.slug];

// Cross-link section: filter the curated `helpsConditions` slugs to ones we
// actually have on the site, then resolve names from the conditions collection.
const linkedConditions = detail
  ? detail.helpsConditions
      .map(slug => allConditions.find(c => c.slug === slug))
      .filter((c): c is Condition => Boolean(c))
  : [];

const waMessage = encodeURIComponent(`Hi, I'd like to book a ${treatment.name} treatment at Vaidya Vrindavanam`);
const waLink = `https://wa.me/${PHONE_PRIMARY_RAW}?text=${waMessage}`;

// Treatments that are part of the seasonal Karkidaka Chikitsa package.
// When the current slug is in this list, render a seasonal callout linking
// to /packages/karkidaka-chikitsa/.
const KARKIDAKA_PACKAGE_TREATMENTS = new Set([
  'abhyangam-swedam',
  'pizhichil',
  'njavara-kizhi',
  'shirodhara',
  'vasthi',
  'nasyam',
  'marma-chikitsa',
]);
const isKarkidakaTherapy = KARKIDAKA_PACKAGE_TREATMENTS.has(treatment.slug);

const categoryLabels: Record<string, string> = {
  panchakarma: 'Panchakarma',
  massage: 'Massage Therapy',
  speciality: 'Speciality Treatment',
};

const relatedHeading: Record<string, string> = {
  panchakarma: 'More Panchakarma Therapies',
  massage: 'More Massage Therapies',
  speciality: 'More Speciality Treatments',
};

// Sidebar table of contents, only render the entries whose sections actually
// exist for this treatment (detail block is optional, conditions list may be
// empty). Mirrors the section IDs declared in the article below.
const tocItems = detail
  ? [
      { id: 'overview', label: 'Overview' },
      { id: 'procedure', label: 'Procedure' },
      { id: 'session', label: 'Session Details' },
      ...(linkedConditions.length > 0 ? [{ id: 'conditions', label: 'Conditions It Helps' }] : []),
      { id: 'faq', label: 'FAQ' },
    ]
  : [];

const schemaGraph: Record<string, unknown>[] = [
  {
    "@type": "MedicalTherapy",
    "name": treatment.name,
    "description": treatment.shortDescription,
    "medicineSystem": "Ayurveda",
    "recognizingAuthority": {
      "@type": "Organization",
      "name": "Ministry of AYUSH, Government of India",
      "url": "https://ayush.gov.in"
    },
    "dateModified": "2026-05-20",
    "provider": {
      "@type": "MedicalBusiness",
      "name": "Vaidya Vrindavanam Ayurveda Hospital",
      "url": "https://vaidyavrindavanam.com",
      "address": POSTAL_ADDRESS_SCHEMA
    }
  },
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://vaidyavrindavanam.com/" },
      { "@type": "ListItem", "position": 2, "name": "Treatments", "item": "https://vaidyavrindavanam.com/treatments/" },
      { "@type": "ListItem", "position": 3, "name": treatment.name, "item": `https://vaidyavrindavanam.com/treatments/${treatment.slug}/` }
    ]
  }
];

if (detail) {
  schemaGraph.push({
    "@type": "FAQPage",
    "mainEntity": detail.faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a,
      },
    })),
  });
}

const schema = {
  "@context": "https://schema.org",
  "@graph": schemaGraph,
};
---

<BaseLayout
  title={treatmentSeoTitles[treatment.slug] ?? `${treatment.name} Treatment in Haripad, Kerala`}
  description={treatmentSeoDescriptions[treatment.slug] ?? `${treatment.shortDescription}, Book at Vaidya Vrindavanam Ayurveda Hospital, Haripad, Kerala.`}
  schema={schema}
  ogImage={treatment.imageUrl ? `${treatment.imageUrl}?w=1200&h=630&fit=crop&auto=format&q=80` : undefined}
>
  <!-- Hero image: full-bleed, gradient fades into page background -->
  {treatment.imageUrl && (
    <div class="relative w-full overflow-hidden hero-image-container">
      <img
        src={`${treatment.imageUrl}?w=1600&h=700&fit=crop&auto=format&q=80`}
        srcset={[
          `${treatment.imageUrl}?w=640&h=280&fit=crop&auto=format&q=80 640w`,
          `${treatment.imageUrl}?w=960&h=420&fit=crop&auto=format&q=78 960w`,
          `${treatment.imageUrl}?w=1280&h=560&fit=crop&auto=format&q=78 1280w`,
          `${treatment.imageUrl}?w=1600&h=700&fit=crop&auto=format&q=80 1600w`,
        ].join(', ')}
        sizes="100vw"
        width="1600"
        height="700"
        alt={`${treatment.name} Ayurvedic treatment at Vaidya Vrindavanam, Haripad`}
        class="w-full h-full object-cover object-center"
        loading="eager"
        fetchpriority="high"
      />
      <!-- Gradient: transparent top → brand-bg at bottom so image melts into page -->
      <div class="absolute inset-0 hero-gradient"></div>
      <!-- Breadcrumb over the image -->
      <div class="absolute bottom-0 left-0 right-0 outer-pad pb-7">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span aria-hidden="true">/</span>
          <a href="/treatments/">Treatments</a>
          <span aria-hidden="true">/</span>
          <span class="breadcrumb-current" aria-current="page">{treatment.name}</span>
        </nav>
      </div>
    </div>
  )}

  <!-- No-image breadcrumb fallback -->
  {!treatment.imageUrl && (
    <div class="bg-brand-bg-alt pt-8 outer-pad pb-0">
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">—</span>
        <a href="/treatments/">Treatments</a>
        <span aria-hidden="true">—</span>
        <span class="breadcrumb-current" aria-current="page">{treatment.name}</span>
      </nav>
    </div>
  )}

  <!-- Document body -->
  <div class="bg-brand-bg">
    <div class="outer-pad doc-container">
      <div class="doc-grid">

        <!-- ── Content column ── -->
        <article class="content-col">
          <header class="doc-header">
            <p class="category-label">{categoryLabels[treatment.category] ?? treatment.category.replace(/-/g, ' ')}</p>
            <h1 class="doc-title">{treatment.name} Treatment in Haripad</h1>
            {(treatment.sanskrit || treatment.malayalam) && (
              <p class="alt-names">
                {treatment.sanskrit && <span>{treatment.sanskrit}</span>}
                {treatment.sanskrit && treatment.malayalam && <span class="alt-sep">·</span>}
                {treatment.malayalam && <span>{treatment.malayalam}</span>}
              </p>
            )}
            {treatment.duration && (
              <p class="duration-label">Duration: {treatment.duration}</p>
            )}
          </header>

          <!-- Mobile CTA, surfaced above the long content so first-scroll users
               reach booking without scrolling past Overview/Procedure/Session/FAQ.
               Hidden ≥1024px where the sticky sidebar takes over. -->
          <div class="mobile-cta mobile-cta--top">
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
              <WhatsAppIcon size={16} />
              WhatsApp to Book
            </a>
            <a href={`tel:+${PHONE_PRIMARY_RAW}`} class="btn-call">Call Us</a>
          </div>

          <!-- Prose content from Sanity -->
          <div class="treatment-prose" set:html={treatment.contentHTML}></div>

          {detail && (
            <>
              <!-- Overview / clinical context -->
              <section id="overview" class="detail-section scroll-mt-20">
                <p class="detail-eyebrow">Overview</p>
                <h2 class="detail-h2">Clinical Context</h2>
                <p class="detail-paragraph">{detail.overview}</p>
              </section>

              <!-- Procedure / how it works -->
              <section id="procedure" class="detail-section scroll-mt-20">
                <p class="detail-eyebrow">How It Works</p>
                <h2 class="detail-h2">Procedure</h2>
                <ol class="procedure-list">
                  {detail.procedure.map((p, i) => (
                    <li class="procedure-item">
                      <span class="procedure-num">{String(i + 1).padStart(2, '0')}</span>
                      <div class="procedure-body">
                        <h3 class="procedure-phase">{p.phase}</h3>
                        <p class="procedure-desc">{p.description}</p>
                      </div>
                    </li>
                  ))}
                </ol>
              </section>

              <!-- Session details -->
              <section id="session" class="detail-section scroll-mt-20">
                <p class="detail-eyebrow">Session Details</p>
                <h2 class="detail-h2">What to Expect</h2>
                <dl class="session-grid">
                  <div class="session-item">
                    <dt class="session-term">Duration</dt>
                    <dd class="session-desc">{detail.sessionDetails.duration}</dd>
                  </div>
                  <div class="session-item">
                    <dt class="session-term">Frequency</dt>
                    <dd class="session-desc">{detail.sessionDetails.frequency}</dd>
                  </div>
                  <div class="session-item">
                    <dt class="session-term">During & After</dt>
                    <dd class="session-desc">{detail.sessionDetails.whatToExpect}</dd>
                  </div>
                  <div class="session-item">
                    <dt class="session-term">Contraindications</dt>
                    <dd class="session-desc">{detail.sessionDetails.contraindications}</dd>
                  </div>
                </dl>
              </section>

              <!-- Conditions this treatment helps -->
              {linkedConditions.length > 0 && (
                <section id="conditions" class="detail-section scroll-mt-20">
                  <p class="detail-eyebrow">Indications</p>
                  <h2 class="detail-h2">Conditions This Treatment Helps</h2>
                  <p class="detail-paragraph">
                    {treatment.name} is part of our protocol for the conditions below. Each linked page describes the full clinical approach for that condition, including how this and complementary therapies are sequenced.
                  </p>
                  <ul class="conditions-link-list">
                    {linkedConditions.map(c => (
                      <li>
                        <a href={`/conditions/${c.slug}/`} class="condition-link">
                          <span class="condition-link-name">{c.name}</span>
                          <span class="condition-link-desc">{c.shortDescription}</span>
                          <span class="condition-link-arrow" aria-hidden="true">→</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )}

              {isKarkidakaTherapy && (
                <section class="detail-section scroll-mt-20">
                  <div class="border border-brand-gold p-6 bg-brand-bg/60">
                    <p class="text-[9px] tracking-[5px] uppercase text-brand-gold">Seasonal · Karkidakam 2026</p>
                    <h3 class="text-lg md:text-xl font-display text-text-primary mt-2">Part of our Karkidaka Chikitsa Programme</h3>
                    <p class="text-sm text-text-secondary leading-relaxed mt-2">{treatment.name} is one of the core therapies of <a href="/karkidaka-chikitsa/" class="text-brand-gold underline">Karkidaka Chikitsa</a>, the classical Kerala monsoon Ayurveda treatment performed each year from 17 July to 16 August. Read the full guide, or skip ahead to the 2026 package details.</p>
                    <div class="flex flex-wrap gap-3 mt-4">
                      <a href="/karkidaka-chikitsa/" class="inline-flex items-center min-h-[44px] text-[10px] tracking-widest uppercase border border-brand-gold text-brand-gold px-4 py-2 hover:bg-brand-gold hover:text-brand-bg transition-colors">Read the Full Guide</a>
                      <a href="/packages/karkidaka-chikitsa/" class="inline-flex items-center min-h-[44px] text-[10px] tracking-widest uppercase bg-brand-gold text-brand-bg px-4 py-2">View 2026 Package →</a>
                    </div>
                  </div>
                </section>
              )}

              <!-- FAQ -->
              <section id="faq" class="detail-section scroll-mt-20">
                <p class="detail-eyebrow">FAQ</p>
                <h2 class="detail-h2">Common Questions</h2>
                <FAQAccordion fullWidth items={detail.faqs.map(f => ({ question: f.q, answer: f.a }))} />
              </section>
            </>
          )}

          <!-- Mobile booking panel (visible only on small screens) -->
          <div class="mobile-cta">
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
              <WhatsAppIcon size={16} />
              WhatsApp to Book
            </a>
            <a href={`tel:+${PHONE_PRIMARY_RAW}`} class="btn-call">Call Us</a>
          </div>
        </article>

        <!-- ── Sticky booking sidebar (desktop only) ── -->
        <aside class="booking-aside" aria-label="Book this treatment">
          {tocItems.length > 0 && (
            <nav class="toc-card" aria-label="On this page">
              <p class="toc-label">On This Page</p>
              <ul class="toc-list">
                {tocItems.map(t => (
                  <li><a href={`#${t.id}`} class="toc-link">{t.label}</a></li>
                ))}
              </ul>
            </nav>
          )}

          <div class="booking-card">
            <p class="booking-card-label">Book This Treatment</p>

            <a href={waLink} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
              <WhatsAppIcon size={16} />
              WhatsApp to Book
            </a>

            <a href={`tel:+${PHONE_PRIMARY_RAW}`} class="btn-call">Call Us</a>

            <hr class="card-divider" aria-hidden="true" />

            <div class="info-block">
              <p class="info-label">Clinic Hours</p>
              <div class="hours-row"><span>Mon – Sat</span><span>9 am – 12 pm</span></div>
              <div class="hours-row"><span>Mon – Sat</span><span>4 pm – 7 pm</span></div>
              <div class="hours-row hours-row--closed"><span>Sunday</span><span>Closed</span></div>
            </div>

            <hr class="card-divider" aria-hidden="true" />

            <div class="info-block">
              <p class="info-label">Location</p>
              <p class="info-text">
                {ADDRESS_LOCALITY}, {ADDRESS_DISTRICT}<br />
                {ADDRESS_REGION}, {ADDRESS_POSTAL_CODE}
              </p>
              <p class="info-note">Residential care available 24/7</p>
            </div>
          </div>
        </aside>

      </div>
    </div>

    {related.length > 0 && (
      <section class="related-section outer-pad" aria-labelledby="related-heading">
        <div class="related-inner">
          <hr class="related-rule" aria-hidden="true" />
          <h2 id="related-heading" class="related-heading">
            {relatedHeading[treatment.category] ?? 'More Treatments'}
          </h2>
          <div class="related-grid">
            {related.map(t => (
              <TreatmentCard
                name={t.name}
                description={t.shortDescription}
                imageUrl={t.imageUrl}
                slug={t.slug}
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <div class="outer-pad back-link-row">
      <a href="/treatments/" class="back-link">← All Treatments</a>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Layout ── */
  .outer-pad {
    padding-left: clamp(1.25rem, 4vw, 4rem);
    padding-right: clamp(1.25rem, 4vw, 4rem);
  }

  .hero-image-container {
    height: clamp(280px, 48vw, 560px);
  }

  .hero-gradient {
    /* Three-stop fade: transparent up top, ~75% scrim by the breadcrumb band, full
       page-bg at the very bottom so the image melts into the page below. The
       opaque lower band guarantees ≥4.5:1 for the breadcrumb regardless of the
       underlying photo. */
    background: linear-gradient(
      to bottom,
      transparent 30%,
      color-mix(in oklab, var(--color-bg) 75%, transparent) 75%,
      var(--color-bg) 100%
    );
  }

  .doc-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-top: 2.5rem;
    padding-bottom: 5rem;
  }

  .doc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  @media (min-width: 1024px) {
    .doc-grid {
      grid-template-columns: 1fr 300px;
      gap: 4rem;
    }
  }

  /* ── Breadcrumb ── */
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.6875rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-gold) 60%, transparent);
  }
  .breadcrumb-nav a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb-nav a:hover {
    color: var(--color-gold);
  }
  .breadcrumb-nav span[aria-hidden] {
    opacity: 0.35;
  }
  .breadcrumb-current {
    color: var(--color-gold);
  }

  /* ── Content header ── */
  .doc-header {
    margin-bottom: 2.5rem;
  }

  .category-label {
    font-size: 0.6875rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-gold);
    margin-bottom: 1rem;
    font-family: var(--font-body);
  }

  .doc-title {
    font-family: var(--font-display);
    font-weight: 300;
    color: var(--color-text-primary);
    line-height: 1.1;
    letter-spacing: 0.015em;
    font-size: clamp(2rem, 5.5vw, 3.25rem);
    margin-bottom: 0.75rem;
  }

  .alt-names {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--color-text-secondary);
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .alt-sep {
    opacity: 0.35;
    font-style: normal;
  }

  .duration-label {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-top: 1rem;
  }

  /* ── Prose (content from Sanity) ── */
  .treatment-prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 300;
    color: var(--color-gold);
    letter-spacing: 0.02em;
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    line-height: 1.25;
  }

  .treatment-prose :global(h3) {
    font-family: var(--font-display);
    font-weight: 300;
    color: var(--color-gold);
    margin-top: 2rem;
    margin-bottom: 0.6rem;
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    line-height: 1.3;
  }

  .treatment-prose :global(p) {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.85;
    margin-bottom: 1.25rem;
    max-width: 66ch;
  }

  .treatment-prose :global(ul) {
    list-style: none;
    padding: 0;
    margin-bottom: 1.5rem;
    max-width: 66ch;
  }

  .treatment-prose :global(ul li) {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.75;
    padding-left: 1.25rem;
    position: relative;
    margin-bottom: 0.35rem;
  }

  .treatment-prose :global(ul li)::before {
    /* Small gold dot as a list marker. Em-dashes were typographically wrong
       (em-dash = parenthetical, not bullet) and a hairline rule looked
       indistinguishable from a dash. A 4px filled dot reads unambiguously as
       a bullet without visual weight. */
    content: '';
    position: absolute;
    left: 0.125rem;
    top: 0.7em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-gold);
  }

  .treatment-prose :global(ol) {
    padding-left: 1.25rem;
    margin-bottom: 1.5rem;
    max-width: 66ch;
  }

  .treatment-prose :global(ol li) {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.75;
    margin-bottom: 0.35rem;
    list-style-type: decimal;
    padding-left: 0.25rem;
  }

  .treatment-prose :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .treatment-prose :global(em) {
    color: var(--color-text-em);
    font-style: italic;
  }

  .treatment-prose :global(a) {
    color: var(--color-gold);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in oklab, var(--color-gold) 30%, transparent);
    transition: border-color 0.2s;
  }

  .treatment-prose :global(a:hover) {
    border-bottom-color: var(--color-gold);
  }

  .treatment-prose :global(blockquote) {
    border: none;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    background: color-mix(in oklab, var(--color-bg) 80%, black);
    color: var(--color-text-primary);
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-style: italic;
    line-height: 1.65;
    max-width: 66ch;
  }

  /* ── Mobile CTA (hidden on desktop) ── */
  .mobile-cta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 2.5rem;
    margin-bottom: 0.5rem;
  }

  /* Top variant: tighter to the header, with a separator below to mark the
     transition into the long-form prose. */
  .mobile-cta--top {
    margin-top: 0;
    margin-bottom: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--color-gold-border);
  }

  @media (min-width: 1024px) {
    .mobile-cta {
      display: none;
    }
  }

  /* ── Back link ── */
  /* ── Related Treatments section ── */
  .related-section {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(2rem, 4vw, 3.5rem);
  }
  .related-inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .related-rule {
    border: 0;
    height: 1px;
    width: 56px;
    background: var(--color-gold);
    opacity: 0.7;
    margin: 0 0 1.5rem 0;
  }
  .related-heading {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.2;
    color: var(--color-text-primary);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.005em;
  }
  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 640px) {
