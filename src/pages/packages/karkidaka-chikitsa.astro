---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CTABanner from '../../components/CTABanner.astro';
import {
  whatsappLink,
  PHONE_PRIMARY,
  PHONE_PRIMARY_RAW,
  PHONE_SECONDARY,
  PHONE_SECONDARY_RAW,
  EMAIL,
  CLINIC_NAME,
  ADDRESS_STREET,
  ADDRESS_LOCALITY,
  ADDRESS_DISTRICT,
  ADDRESS_REGION,
  ADDRESS_POSTAL_CODE,
  ADDRESS_COUNTRY_LABEL,
  POSTAL_ADDRESS_SCHEMA,
} from '../../config/contact';
import '../../styles/hero-animations.css';

const pageUrl = 'https://vaidyavrindavanam.com/packages/karkidaka-chikitsa/';
const waLink7 = whatsappLink("Hi, I'd like details about the 7-day Karkidaka Chikitsa Package at Vaidya Vrindavanam.");
const waLink14 = whatsappLink("Hi, I'd like details about the 14-day Karkidaka Chikitsa Package at Vaidya Vrindavanam.");
const waLink21 = whatsappLink("Hi, I'd like details about the 21-day Karkidaka Chikitsa Package at Vaidya Vrindavanam.");
const waLinkGeneral = whatsappLink("Hi, I'm interested in the Karkidaka Chikitsa Package. Please share the schedule and inclusions.");

const tiers = [
  {
    name: '7-Day Karkidaka Retreat',
    duration: '7 days',
    waLink: waLink7,
    suitedFor: 'Working professionals, first-time Ayurveda visitors, gentle reset',
    therapies: [
      'Daily Abhyangam (medicated oil massage)',
      'Pizhichil or Elakizhi (alternate days)',
      'Shirodhara (3 sessions)',
      'Karkidaka Kanji every morning',
      'Rasayana herbal formulations',
      'Doctor consultation (Day 1, Day 4, Day 7)',
    ],
  },
  {
    name: '14-Day Karkidaka Chikitsa',
    duration: '14 days',
    popular: true,
    waLink: waLink14,
    suitedFor: 'Chronic joint pain, stress, post-monsoon immunity: our most-booked tier',
    therapies: [
      'Full Panchakarma sequence (Snehapanam → Vamanam or Virechanam)',
      'Daily Abhyangam + Swedam',
      'Pizhichil (5 sessions)',
      'Navarakizhi (5 sessions)',
      'Shirodhara (7 sessions)',
      'Karkidaka Vasthi (medicated enema course)',
      'Daily Karkidaka Kanji + Rasayana ghritam',
      'Doctor consultations every 3 days',
    ],
  },
  {
    name: '21-Day Karkidaka Rasayana',
    duration: '21 days',
    waLink: waLink21,
    suitedFor: 'Rheumatoid arthritis, paralysis recovery, deep rejuvenation, NRI patients',
    therapies: [
      'Complete Panchakarma course (Poorvakarma → Pradhanakarma → Paschatkarma)',
      'Daily Abhyangam, Pizhichil and Navarakizhi rotation',
      'Shirodhara (14 sessions)',
      'Sirovasti (7 sessions)',
      'Marma Chikitsa with chiropractic alignment',
      'Karkidaka Kanji + customised Rasayana protocol',
      'Diet, yoga and lifestyle plan to carry home',
      'Daily doctor review',
    ],
  },
];

const therapies = [
  { slug: 'abhyangam-swedam', name: 'Abhyangam', description: 'Warm medicated oil massage that opens the channels and prepares the body for deeper detox.' },
  { slug: 'pizhichil', name: 'Pizhichil', description: 'Kerala\'s royal oil-bath therapy for arthritis, paralysis and full-body rejuvenation during Karkidakam.' },
  { slug: 'njavara-kizhi', name: 'Navarakizhi', description: 'Warm Njavara rice bolus massage that nourishes muscles and joints in the cool monsoon.' },
  { slug: 'shirodhara', name: 'Shirodhara', description: 'Continuous oil stream on the forehead: the signature stress, insomnia and migraine therapy.' },
  { slug: 'vasthi', name: 'Karkidaka Vasthi', description: 'Medicated enema: the most powerful Panchakarma therapy for Vata disorders, sciatica and IBS.' },
  { slug: 'nasyam', name: 'Nasyam', description: 'Nasal oil therapy for sinusitis, migraines and cervical spondylosis, ideal during monsoon dampness.' },
];

const faqs = [
  {
    question: 'What is Karkidaka Chikitsa?',
    answer: 'Karkidaka Chikitsa (also called Karkidaka Vavu Chikitsa or monsoon Ayurveda) is a classical seasonal treatment performed in the Malayalam month of Karkidakam (roughly mid-July to mid-August). Because the body is naturally more receptive to detox and the climate is cool and damp, this is regarded by Ayurveda (and texts like Ashtanga Hridayam) as the most effective window of the year for Panchakarma, Rasayana and rejuvenation therapies. The package at Vaidya Vrindavanam combines Abhyangam, Pizhichil, Navarakizhi, Shirodhara, Karkidaka Vasthi, Karkidaka Kanji and Rasayana herbs supervised by our resident Vaidyas in Haripad, Alappuzha.',
  },
  {
    question: 'When is the Karkidakam season in 2026?',
    answer: 'Karkidakam 2026 runs from 17 July to 16 August 2026 (Malayalam Era 1201). For best results we recommend starting treatment within the first 10 days of the month so the full protocol completes within the season. We accept bookings from 1 June and 14-day / 21-day tiers tend to fill first; secure your slot early via WhatsApp on +91 90748 48705.',
  },
  {
    question: 'How long does the package run and which duration should I choose?',
    answer: 'We offer 7-day, 14-day and 21-day tiers. The 7-day retreat is a gentle reset suitable for working professionals and first-time visitors. The 14-day Karkidaka Chikitsa is our most-booked tier and the minimum for a complete Panchakarma sequence for chronic joint pain, stress or post-monsoon immunity. The 21-day Karkidaka Rasayana is recommended for rheumatoid arthritis, paralysis recovery and NRI patients who want deep, long-lasting rejuvenation. Final duration is confirmed by Dr. Jayakrishnan T J after a consultation.',
  },
  {
    question: 'What are the Karkidaka Chikitsa package rates?',
    answer: `Karkidaka Chikitsa package rates depend on duration, therapy mix and whether you choose residential or out-patient care. Because Karkidaka Chikitsa is fully personalised after a doctor consultation, we share an itemised quote on request. WhatsApp ${PHONE_PRIMARY} or call ${PHONE_SECONDARY} for the current Karkidakam 2026 Karkidaka Chikitsa package rates; we will also confirm room availability and pick-up assistance from Kochi, Trivandrum or Kollam.`,
  },
  {
    question: 'Is there a Karkidaka Chikitsa package near me in Trivandrum or Kochi?',
    answer: 'Vaidya Vrindavanam is the closest authentic Karkidaka Chikitsa package near patients searching from Trivandrum, Kochi, Kollam, Alappuzha and Pathanamthitta. We are 3 hours from Kochi airport, 3 hours from Trivandrum airport, and 2 hours from Kollam. Patients also compare our Karkidaka Chikitsa package against the Karkidaka Chikitsa package in Kottakkal; both follow classical Kerala protocols, but at Vaidya Vrindavanam every guest is personally supervised by the senior Vaidya each day rather than following a fixed brochure schedule. Karkidaka Chikitsa package Trivandrum and Karkidaka Chikitsa package Kochi guests typically book the 14-day or 21-day tier so the travel cost amortises across the full Panchakarma sequence.',
  },
  {
    question: 'Can I do Karkidaka Chikitsa at home?',
    answer: 'A few elements (Karkidaka Kanji, prescribed Rasayana herbs and a simple Abhyangam routine) can be done at home with guidance. However, the core Panchakarma therapies (Pizhichil, Navarakizhi, Karkidaka Vasthi, Shirodhara, Sirovasti) require trained therapists, sterile preparation, medicated decoctions and daily doctor monitoring. For real benefit during Karkidakam we recommend a supervised programme at the clinic; we can also design a take-home protocol after your stay.',
  },
  {
    question: 'Where are you located and how do I reach you?',
    answer: `${CLINIC_NAME} is near RK Junction on NH-66 in Haripad, Alappuzha district, Kerala, about 3 hours from Kochi airport (COK), 3 hours from Trivandrum airport (TRV), and 2 hours from Kollam. Address: ${ADDRESS_STREET}, ${ADDRESS_LOCALITY}, ${ADDRESS_DISTRICT}, ${ADDRESS_REGION} ${ADDRESS_POSTAL_CODE}. We can arrange airport pickup for residential package guests; mention this when you WhatsApp ${PHONE_PRIMARY}.`,
  },
  {
    question: 'Who should NOT take Karkidaka Chikitsa?',
    answer: 'Karkidaka Chikitsa is broadly safe but is not advised during pregnancy, active fevers or acute infections, immediately after major surgery, in severe uncontrolled diabetes or hypertension, or in advanced cardiac disease. Some asthmatic patients tolerate the humidity of monsoon less well and may be offered a modified protocol. Every guest is screened by Dr. Jayakrishnan T J or Dr. Ganga S S before therapy begins; we will redirect you to a more suitable plan if needed.',
  },
  {
    question: 'How is our Karkidaka Chikitsa package different from Karkidaka Chikitsa Kottakkal or other Kerala centres?',
    answer: 'Two differences between our Karkidaka Chikitsa Kerala programme and Karkidaka Chikitsa Kottakkal. First, our signature is Marma Chikitsa combined with modern chiropractic correction. Alongside classical Karkidaka Chikitsa Panchakarma, we address the structural component of joint and back conditions, which most centres do not. Second, we are a small clinical practice (operating since 2014) rather than a large resort: every guest is personally seen by the senior Vaidya each day, and protocols are adjusted in real time rather than following a fixed Karkidaka Chikitsa package Kottakkal-style brochure. Pricing is also typically 25–40% lower than the large branded chains for an equivalent therapy mix.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MedicalWebPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: 'Karkidaka Chikitsa Package: Monsoon Ayurveda in Kerala',
      description: 'Authentic Karkidaka Chikitsa packages (7, 14 and 21-day) in Haripad, Alappuzha, Kerala. Panchakarma, Rasayana and Karkidaka Kanji by certified Vaidyas. Operating since 2014.',
      inLanguage: ['en-IN', 'ml-IN'],
      about: {
        '@type': 'MedicalCondition',
        name: 'Seasonal monsoon detoxification and rejuvenation',
      },
      audience: {
        '@type': 'PeopleAudience',
        geographicArea: { '@type': 'Country', name: 'India' },
      },
      lastReviewed: '2026-05-19',
      reviewedBy: {
        '@type': 'Physician',
        name: 'Dr. Jayakrishnan T J',
      },
    },
    {
      '@type': 'Service',
      '@id': `${pageUrl}#service`,
      name: 'Karkidaka Chikitsa Package',
      alternateName: ['Karkidaka Vavu Chikitsa', 'Monsoon Ayurveda Treatment', 'Karkidakam Treatment'],
      serviceType: 'Seasonal Ayurvedic Panchakarma',
      category: 'Ayurveda',
      description: 'Classical Karkidaka Chikitsa (Karkidakam monsoon treatment) combining Abhyangam, Pizhichil, Navarakizhi, Shirodhara, Karkidaka Vasthi, Karkidaka Kanji and personalised Rasayana herbs. Available as 7-day, 14-day and 21-day residential or out-patient packages.',
      areaServed: [
        { '@type': 'State', name: 'Kerala' },
        { '@type': 'City', name: 'Alappuzha' },
        { '@type': 'City', name: 'Haripad' },
        { '@type': 'City', name: 'Kochi' },
        { '@type': 'City', name: 'Trivandrum' },
        { '@type': 'City', name: 'Kollam' },
      ],
      provider: {
        '@type': 'MedicalBusiness',
        '@id': 'https://vaidyavrindavanam.com/#organization',
        name: 'Vaidya Vrindavanam Ayurveda Hospital',
        url: 'https://vaidyavrindavanam.com',
        telephone: PHONE_PRIMARY,
        email: EMAIL,
        address: POSTAL_ADDRESS_SCHEMA,
        medicalSpecialty: 'Ayurveda',
        foundingDate: '2014',
      },
      availableChannel: [
        { '@type': 'ServiceChannel', serviceUrl: `https://wa.me/${PHONE_PRIMARY_RAW}`, name: 'WhatsApp Booking' },
        { '@type': 'ServiceChannel', servicePhone: PHONE_SECONDARY, name: 'Phone' },
      ],
      offers: {
        '@type': 'Offer',
        priceCurrency: 'INR',
        priceSpecification: { '@type': 'PriceSpecification', valueAddedTaxIncluded: true },
        availability: 'https://schema.org/InStock',
        validFrom: '2026-06-01',
        validThrough: '2026-08-31',
        url: pageUrl,
        description: 'Contact for current package pricing. 7/14/21-day tiers available during Karkidakam 2026 (17 July – 16 August).',
      },
    },
    {
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://vaidyavrindavanam.com/' },
        { '@type': 'ListItem', position: 2, name: 'Packages', item: 'https://vaidyavrindavanam.com/packages/' },
        { '@type': 'ListItem', position: 3, name: 'Karkidaka Chikitsa Package', item: pageUrl },
      ],
    },
    {
      '@type': 'Physician',
      '@id': 'https://vaidyavrindavanam.com/#dr-jayakrishnan',
      name: 'Dr. Jayakrishnan T J',
      medicalSpecialty: 'Ayurveda',
      worksFor: { '@id': 'https://vaidyavrindavanam.com/#organization' },
    },
    {
      '@type': 'Physician',
      '@id': 'https://vaidyavrindavanam.com/#dr-ganga',
      name: 'Dr. Ganga S S',
      medicalSpecialty: 'Ayurveda',
      worksFor: { '@id': 'https://vaidyavrindavanam.com/#organization' },
    },
  ],
};
---

<BaseLayout
  title="Karkidaka Chikitsa Package"
  description="Authentic Karkidaka Chikitsa packages in Haripad, Kerala. 7/14/21-day monsoon Ayurveda detox by certified Vaidyas. Operating since 2014. WhatsApp to book."
  schema={schema}
>
  <!-- 1. HERO -->
  <section class="relative py-28 md:py-40 px-6 overflow-hidden isolate">
    <div aria-hidden="true" class="absolute inset-0 -z-10" style="background: radial-gradient(ellipse 110% 90% at 50% -15%, oklch(0.30 0.038 140) 0%, transparent 62%), linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);"></div>
<div class="max-w-4xl mx-auto text-center relative z-10">
      <p class="hero-eyebrow text-xs tracking-[5px] uppercase text-brand-gold mb-4">Seasonal Programme · 17 July – 16 August 2026</p>
      <h1 class="hero-heading font-display font-light text-text-primary tracking-wide leading-[1.05]" style="font-size: clamp(2.8rem, 6vw + 1rem, 5.5rem);">
        Karkidaka Chikitsa Package
      </h1>
      <div class="hero-line w-12 h-px bg-brand-gold mx-auto mt-8 origin-center"></div>
      <p class="hero-sub text-sm md:text-base text-text-secondary mt-6 max-w-2xl mx-auto leading-relaxed">
        The classical seven, fourteen and twenty-one day Karkidaka Chikitsa packages at Vaidya Vrindavanam combine Panchakarma, Karkidaka Kanji and Rasayana, supervised in person by our resident Vaidyas in Haripad, Alappuzha. For patients searching for authentic <strong class="text-text-primary">Karkidaka Chikitsa near me</strong> in Kerala, this is the closest residential Karkidaka Chikitsa treatment to Trivandrum, Kochi, Kollam and Alappuzha.
      </p>
      <div class="hero-cta flex gap-3 justify-center flex-wrap mt-10">
        <a
          href={waLinkGeneral}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-h-[44px] bg-brand-whatsapp text-white px-7 py-4 text-xs font-bold tracking-widest"
        >
          Enquire on WhatsApp
        </a>
        <a
          href={`tel:+${PHONE_PRIMARY_RAW}`}
          class="inline-flex items-center justify-center min-h-[44px] bg-brand-gold text-brand-bg px-7 py-4 text-xs font-bold tracking-widest"
        >
          Call {PHONE_PRIMARY}
        </a>
      </div>
      <p class="hero-aside text-xs tracking-[3px] uppercase text-text-muted mt-10">
        Operating since 2014 · Haripad, Alappuzha · Kerala
      </p>
    </div>
  </section>

  <!-- 2. BREADCRUMB -->
  <nav aria-label="Breadcrumb" class="px-6 py-4 bg-brand-bg border-b border-brand-gold-dim">
    <ol class="max-w-4xl mx-auto flex flex-wrap items-center gap-2 text-xs text-text-muted">
      <li><a href="/" class="inline-flex items-center min-h-[44px] hover:text-brand-gold transition-colors duration-150">Home</a></li>
      <li aria-hidden="true">›</li>
      <li><a href="/packages/" class="inline-flex items-center min-h-[44px] hover:text-brand-gold transition-colors duration-150">Packages</a></li>
      <li aria-hidden="true">›</li>
      <li aria-current="page" class="text-text-secondary">Karkidaka Chikitsa Package</li>
    </ol>
  </nav>

  <!-- 3. WHAT IS KARKIDAKA CHIKITSA -->
  <section class="py-16 px-6 bg-brand-bg">
    <div class="max-w-3xl mx-auto">
      <SectionHeader heading="What is Karkidaka Chikitsa?" align="left" />
      <div class="prose-custom text-text-secondary leading-relaxed space-y-4 text-base">
        <p>
          <strong class="text-text-primary">Karkidaka Chikitsa</strong>, also called <em>Karkidaka Vavu Chikitsa</em> or simply <em>monsoon Ayurveda treatment</em>, is the classical seasonal Panchakarma performed in the Malayalam month of <strong>Karkidakam</strong> (mid-July to mid-August). For more than a thousand years, Kerala households have observed this month as the body's annual reset: the digestive fire is gentle, the climate is cool and damp, the channels are open, and the body is therefore at its most receptive to detoxification, Rasayana (rejuvenation) and immunity-building therapies.
        </p>
        <p>
          The Ayurvedic classics, including the <em>Ashtanga Hridayam</em>, describe Karkidakam as the season when Vata is naturally aggravated and Pitta begins to accumulate, making it the ideal window to clear Ama (metabolic toxin), rebalance the doshas and lay the groundwork for the rest of the year. A well-designed Karkidaka Chikitsa programme is built on three pillars: <strong>Sodhana</strong> (cleansing through Panchakarma), <strong>Aushada Sevana</strong> (medicated decoctions, ghrita and Rasayana herbs), and <strong>Pathya</strong> (the famed <em>Karkidaka Kanji</em> and a calming, easily-digested diet).
        </p>
        <p>
          At Vaidya Vrindavanam in Haripad, our Karkidaka Chikitsa packages bring this tradition into a clinical setting, combining classical Pizhichil, Navarakizhi, Shirodhara, Karkidaka Vasthi and Sirovasti with our signature <strong>Marma Chikitsa</strong> and modern chiropractic correction. Every protocol is personalised by Dr. Jayakrishnan T J after a one-to-one consultation, so the therapy mix actually fits your constitution and complaint, not a fixed brochure package.
        </p>
        <p class="text-xs text-text-muted italic border border-brand-gold-dim bg-brand-gold/5 px-4 py-3 mt-5">
          New to Karkidaka Chikitsa? Read our complete guide: <a href="/karkidaka-chikitsa/" class="text-brand-gold underline">What is Karkidaka Chikitsa: the full clinical guide →</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 4. MALAYALAM BLOCK -->
  <section lang="ml" class="py-16 px-6 bg-brand-bg-alt border-y border-brand-gold-dim">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-xs tracking-[3px] uppercase text-brand-gold mb-3" lang="en">Karkidaka Chikitsa in Malayalam · കർക്കടക ചികിത്സ മലയാളത്തിൽ</p>
      <h2 class="text-2xl md:text-3xl font-display font-light text-text-primary tracking-wide">
        കർക്കടക ചികിത്സ എന്താണ്?
      </h2>
      <div class="w-8 h-px bg-brand-gold mx-auto mt-4 mb-6"></div>
      <div class="text-text-secondary leading-loose space-y-4 text-base text-left">
        <p>
          കർക്കടക മാസത്തിലെ പരമ്പരാഗത ആയുർവേദ ചികിത്സയാണ് കർക്കടക ചികിത്സ. ഈ കാലത്ത് ശരീരത്തിലെ വാത ദോഷം വർദ്ധിക്കുകയും, ദഹനശക്തി കുറയുകയും ചെയ്യും. അതുകൊണ്ടാണ് ഈ മാസത്തിൽ പഞ്ചകർമ, രസായനം, കർക്കടക കഞ്ഞി എന്നിവ ഏറ്റവും ഫലപ്രദമാകുന്നത്.
        </p>
        <p>
          ഹരിപ്പാട് വൈദ്യ വൃന്ദാവനത്തിൽ, 2014 മുതൽ പ്രവർത്തിക്കുന്നു, ഞങ്ങൾ 7, 14, 21 ദിവസത്തെ കർക്കടക ചികിത്സ പാക്കേജുകൾ വാഗ്ദാനം ചെയ്യുന്നു. പിഴിച്ചിൽ, നവരക്കിഴി, ശിരോധാര, കർക്കടക വസ്തി, അഭ്യംഗം എന്നിവ ഉൾപ്പെടുന്നു. വൈദ്യൻമാരുടെ നേരിട്ടുള്ള മേൽനോട്ടത്തിൽ, വ്യക്തിഗതമായ ചികിത്സാ പദ്ധതി.
        </p>
        <p class="text-sm">
          ബുക്ക് ചെയ്യാൻ വാട്സ്ആപ്പ് ചെയ്യുക: <a href={waLinkGeneral} class="text-brand-gold underline" target="_blank" rel="noopener noreferrer">+91 90748 48705</a>
        </p>
      </div>
    </div>
  </section>

  <!-- 5. PACKAGE INCLUSIONS -->
  <section id="packages" class="py-16 px-6 bg-brand-bg">
    <div class="max-w-5xl mx-auto">
      <SectionHeader heading="What's Included in Our Karkidaka Chikitsa Package" subtitle="Choose by duration: final protocol is personalised after consultation" />
      <div class="grid md:grid-cols-3 gap-6 mt-8">
        {tiers.map((tier) => (
          <div class:list={["relative flex flex-col p-6", tier.popular ? "border border-brand-gold bg-brand-gold/5 md:scale-[1.05] md:z-10" : "border border-brand-gold-border bg-brand-bg/60"]}>
            {tier.popular && (
              <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-gold text-brand-bg text-[10px] font-bold tracking-widest px-3 py-1">MOST BOOKED</div>
            )}
            <h3 class="text-lg font-display text-text-primary text-center mt-2">{tier.name}</h3>
            <p class="text-xs text-brand-gold text-center mt-1 tracking-widest uppercase">{tier.duration}</p>
            <p class="text-xs text-text-muted italic text-center leading-relaxed mt-3">{tier.suitedFor}</p>
            <ul class="mt-5 space-y-2 flex-1">
              {tier.therapies.map((t) => (
                <li class="text-sm text-text-secondary leading-relaxed">{t}</li>
              ))}
            </ul>
            <a
              href={tier.waLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center min-h-[44px] mt-6 bg-brand-gold text-brand-bg px-5 py-3 text-xs font-bold tracking-widest"
            >
              ENQUIRE ON WHATSAPP →
            </a>
          </div>
        ))}
      </div>
      <p class="text-xs text-text-muted text-center mt-8 italic max-w-2xl mx-auto">
        Pricing depends on duration, therapy mix and residential vs. out-patient care. Itemised quote shared on request. Karkidakam 2026 bookings open from 1 June.
      </p>
    </div>
  </section>

  <!-- 6. BENEFITS -->
